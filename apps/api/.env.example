NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Auth (FS02) -----------------------------------------------------------
# Secret for signing/verifying access JWTs. Required, >= 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=<generate-a-random-secret-at-least-32-characters-long>
JWT_ISSUER=fs-api
JWT_AUDIENCE=fs-api-clients

# Cookie flags. AUTH_COOKIE_SECURE defaults to true in production and
# false otherwise if left unset (so local HTTP dev works out of the box).
# AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

# Comma-separated extra origins allowed to make credentialed,
# state-changing requests, beyond the request's own same-origin (which is
# always allowed). Leave unset for the default same-origin-proxy setup.
# AUTH_ALLOWED_ORIGINS=https://example.com,https://staging.example.com

# Refresh token rotation grace window, in milliseconds. See docs/api.md
# "Concurrent refresh policy".
AUTH_REFRESH_GRACE_MS=10000

# Login throttling (see docs/api.md "Throttling").
AUTH_LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=5
AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=20
AUTH_LOGIN_WINDOW_MS=900000

# Registration (FS04) -----------------------------------------------------
# The single company every publicly-registered user is assigned to. Must
# be a real, existing, active Company document's _id — create one first
# (e.g. via mongosh: db.companies.insertOne({ name: "Demo Company",
# isActive: true, createdAt: new Date(), updatedAt: new Date() })) and put
# its _id here. Left unset, POST /api/v1/auth/register fails safely with
# 503 DEMO_COMPANY_UNAVAILABLE rather than creating a company itself.
DEMO_COMPANY_ID=<the-demo-company-objectid>

# Registration throttling (see docs/api.md "Throttling") — coarser than
# login's, per-IP only.
AUTH_REGISTER_MAX_ATTEMPTS_PER_IP=10
AUTH_REGISTER_WINDOW_MS=3600000

# Gemini device analysis (FS14) --------------------------------------------
# Server-side only. Get a key from Google AI Studio (https://aistudio.google.com/apikey).
# Left unset, analyzeDevices() returns a controlled GEMINI_AUTH_ERROR result
# instead of crashing the app or falling back to a placeholder key.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Single fixed model, free-tier eligible as of 2026-09-24 (see docs/api.md
# "Gemini model selection" for the verification source). No fallback model
# is ever configured.
GEMINI_MODEL=gemini-3.8-flash

# Bounded timeout for the Gemini call, in milliseconds.
GEMINI_TIMEOUT_MS=15000

# Shared MongoDB-backed throttle (reuses modules/auth/auth-throttle.model.ts)
# protecting the single free-tier quota itself — see docs/api.md
# "Gemini rate limiting" for the keying rationale.
GEMINI_RATE_LIMIT_MAX_ATTEMPTS=5
GEMINI_RATE_LIMIT_WINDOW_MS=60000

# Service requests (FS15) --------------------------------------------------
# Per-customer POST /requests submission throttle (see docs/api.md).
REQUEST_CREATE_MAX_ATTEMPTS_PER_USER=20
REQUEST_CREATE_WINDOW_MS=3600000

# Demo seed (FS34) -----------------------------------------------------------
# Only read by `pnpm seed:demo` (src/scripts/seed-demo.ts), never by the API.
# DEMO_SEED_DATABASE must equal the database name in MONGODB_URI, as an
# explicit "yes, this is the demo database" confirmation. The seed creates
# the company at DEMO_COMPANY_ID itself. Every demo account
# (*@demo.chillwork.test) uses DEMO_SEED_PASSWORD (at least 12 characters).
# DEMO_SEED_DATABASE=<the-demo-database-name>
# DEMO_SEED_PASSWORD=<choose-a-demo-password>
