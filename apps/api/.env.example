NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Auth (FS02) -----------------------------------------------------------
# Secret for signing/verifying access JWTs. Required, >= 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=<generate-a-random-secret-at-least-32-characters-long>
JWT_ISSUER=fs-api
JWT_AUDIENCE=fs-api-clients

# Cookie flags. AUTH_COOKIE_SECURE defaults to true in production and
# false otherwise if left unset (so local HTTP dev works out of the box).
# AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

# Comma-separated extra origins allowed to make credentialed,
# state-changing requests, beyond the request's own same-origin (which is
# always allowed). Leave unset for the default same-origin-proxy setup.
# AUTH_ALLOWED_ORIGINS=https://example.com,https://staging.example.com

# Refresh token rotation grace window, in milliseconds. See docs/api.md
# "Concurrent refresh policy".
AUTH_REFRESH_GRACE_MS=10000

# Login throttling (see docs/api.md "Throttling").
AUTH_LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=5
AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=20
AUTH_LOGIN_WINDOW_MS=900000
